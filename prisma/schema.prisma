// SnackLoad — relational model.
// Design rationale lives in docs/01-data-model.md; the invariants this schema is
// shaped to protect are in docs/02-inventory-and-money-rules.md.
//
// Conventions:
//   * Every tenant-owned table carries organizationId and indexes it first.
//   * All quantities are SIGNED INTEGERS in the product's base unit.
//   * All money is Decimal. Amounts 14,4 · prices 12,4 · costs 16,6 · rates 9,6.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  legalName     String?            @map("legal_name")
  email         String?
  phone         String?
  addressLine1  String?            @map("address_line1")
  addressLine2  String?            @map("address_line2")
  city          String?
  state         String?
  postalCode    String?            @map("postal_code")
  country       String             @default("US")
  timezone      String             @default("America/New_York")
  currency      String             @default("USD")
  logoUrl       String?            @map("logo_url")
  receiptFooter String?            @map("receipt_footer")
  status        OrganizationStatus @default(ACTIVE)
  plan          String             @default("standard")

  /// Per-org behaviour switches (see docs/02 §L4). Shape: OrganizationSettings.
  settings       Json @default("{}")
  /// Completion state of the onboarding checklist (spec §49).
  onboardingJson Json @default("{}") @map("onboarding_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships            Membership[]
  roles                  Role[]
  invitations            Invitation[]
  sessions               Session[]
  suppliers              Supplier[]
  categories             ProductCategory[]
  products               Product[]
  productUoms            ProductUom[]
  priceGroups            PriceGroup[]
  priceGroupPrices       PriceGroupPrice[]
  customerPrices         CustomerPrice[]
  taxRates               TaxRate[]
  customers              Customer[]
  customerContacts       CustomerContact[]
  inventoryLocations     InventoryLocation[]
  warehouses             Warehouse[]
  vehicles               Vehicle[]
  inventoryBalances      InventoryBalance[]
  inventoryTransactions  InventoryTransaction[]
  inventoryLines         InventoryTransactionLine[]
  receivings             Receiving[]
  receivingItems         ReceivingItem[]
  truckLoads             TruckLoad[]
  truckLoadItems         TruckLoadItem[]
  routeTemplates         RouteTemplate[]
  customerSchedules      CustomerSchedule[]
  routes                 Route[]
  routeStops             RouteStop[]
  routeAssignmentHistory RouteAssignmentHistory[]
  routeCloseouts         RouteCloseout[]
  routeCloseoutItems     RouteCloseoutItem[]
  sales                  Sale[]
  saleItems              SaleItem[]
  receipts               Receipt[]
  receiptDeliveries      ReceiptDelivery[]
  receiptShareLinks      ReceiptShareLink[]
  signatures             Signature[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  returns                Return[]
  returnItems            ReturnItem[]
  creditMemos            CreditMemo[]
  creditMemoItems        CreditMemoItem[]
  creditApplications     CreditMemoApplication[]
  refunds                Refund[]
  importJobs             ImportJob[]
  importRows             ImportRow[]
  integrations           IntegrationConnection[]
  externalMappings       ExternalMapping[]
  syncJobs               SyncJob[]
  syncLogs               SyncLog[]
  outboxEvents           OutboxEvent[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  documentSequences      DocumentSequence[]

  @@map("organization")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Global identity. Access to a company is granted by Membership, never by this row.
model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String     @map("password_hash")
  passwordAlgo     String     @default("scrypt") @map("password_algo")
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  phone            String?
  avatarUrl        String?    @map("avatar_url")
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?  @map("last_login_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  memberships           Membership[]
  sessions              Session[]
  invitationsSent       Invitation[]             @relation("InvitationInviter")
  invitationsAccepted   Invitation[]             @relation("InvitationAcceptor")
  vehiclesAssigned      Vehicle[]                @relation("VehicleAssignee")
  routeTemplatesDefault RouteTemplate[]          @relation("RouteTemplateDefaultRunner")
  routesRun             Route[]                  @relation("RouteRunner")
  inventoryTransactions InventoryTransaction[]   @relation("InventoryTransactionActor")
  receivings            Receiving[]              @relation("ReceivingActor")
  truckLoadsCreated     TruckLoad[]              @relation("TruckLoadCreator")
  truckLoadsRun         TruckLoad[]              @relation("TruckLoadRunner")
  salesSold             Sale[]                   @relation("SaleSeller")
  salesVoided           Sale[]                   @relation("SaleVoider")
  receiptDeliveries     ReceiptDelivery[]        @relation("DeliverySender")
  receiptShareLinks     ReceiptShareLink[]       @relation("ShareLinkCreator")
  paymentsReceived      Payment[]                @relation("PaymentReceiver")
  paymentsReversed      Payment[]                @relation("PaymentReverser")
  returnsCreated        Return[]                 @relation("ReturnCreator")
  returnsVoided         Return[]                 @relation("ReturnVoider")
  creditsIssued         CreditMemo[]             @relation("CreditIssuer")
  creditsVoided         CreditMemo[]             @relation("CreditVoider")
  creditsApplied        CreditMemoApplication[]  @relation("CreditApplier")
  refundsIssued         Refund[]                 @relation("RefundIssuer")
  refundsVoided         Refund[]                 @relation("RefundVoider")
  closeoutsSubmitted    RouteCloseout[]          @relation("CloseoutSubmitter")
  closeoutsReviewed     RouteCloseout[]          @relation("CloseoutReviewer")
  reassignmentsFrom     RouteAssignmentHistory[] @relation("ReassignFrom")
  reassignmentsTo       RouteAssignmentHistory[] @relation("ReassignTo")
  reassignmentsCreated  RouteAssignmentHistory[] @relation("ReassignActor")
  importJobs            ImportJob[]              @relation("ImportCreator")
  integrationsConnected IntegrationConnection[]  @relation("IntegrationConnector")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([status])
  @@map("app_user")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model Membership {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  userId           String           @map("user_id")
  roleId           String           @map("role_id")
  status           MembershipStatus @default(ACTIVE)
  employeeCode     String?          @map("employee_code")
  /// Truck this person normally drives; the default selling location for their sales.
  defaultVehicleId String?          @map("default_vehicle_id")
  joinedAt         DateTime         @default(now()) @map("joined_at")
  removedAt        DateTime?        @map("removed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  defaultVehicle Vehicle?     @relation(fields: [defaultVehicleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("membership")
}

/// A named bundle of permissions. Seeded per organization so custom roles in V2
/// are an INSERT, not a deploy. Nothing in the codebase branches on role.key.
model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("role")
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String @map("role_id")
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permission")
}

model Invitation {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  email            String
  roleId           String    @map("role_id")
  tokenHash        String    @unique @map("token_hash")
  invitedByUserId  String    @map("invited_by_user_id")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, email])
  @@map("invitation")
}

enum SessionClient {
  WEB
  NATIVE
  API
}

/// The raw token is never stored — only sha256(token). Cookie and Bearer are two
/// carriers of the same credential (docs/04 §2).
model Session {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  organizationId String        @map("organization_id")
  tokenHash      String        @unique @map("token_hash")
  client         SessionClient @default(WEB)
  userAgent      String?       @map("user_agent")
  ipAddress      String?       @map("ip_address")
  expiresAt      DateTime      @map("expires_at")
  lastUsedAt     DateTime      @default(now()) @map("last_used_at")
  revokedAt      DateTime?     @map("revoked_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  accountNumber  String?  @map("account_number")
  contactName    String?  @map("contact_name")
  phone          String?
  email          String?
  addressLine1   String?  @map("address_line1")
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  leadTimeDays   Int?     @map("lead_time_days")
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  receivings   Receiving[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("supplier")
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  parentId       String?  @map("parent_id")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("product_category")
}

model Product {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  sku            String
  upc            String?
  name           String
  description    String?
  brand          String?
  categoryId     String? @map("category_id")
  supplierId     String? @map("supplier_id")

  /// Label for the atom this product is counted in (BAG, BOTTLE, CAN, BAR…).
  /// Every stored quantity in the system is an integer count of these.
  baseUomLabel String @default("Each") @map("base_uom_label")

  /// Weighted-average acquisition cost of ONE base unit. Six decimals because
  /// a case cost divided by a case factor is rarely exact (docs/02 §M1).
  costPerBaseUnit Decimal @default(0) @map("cost_per_base_unit") @db.Decimal(16, 6)

  reorderPointBaseUnits Int      @default(0) @map("reorder_point_base_units")
  taxable               Boolean  @default(true)
  active                Boolean  @default(true)
  imageUrl              String?  @map("image_url")
  weightGrams           Int?     @map("weight_grams")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ProductCategory?           @relation(fields: [categoryId], references: [id])
  supplier         Supplier?                  @relation(fields: [supplierId], references: [id])
  uoms             ProductUom[]
  balances         InventoryBalance[]
  ledgerLines      InventoryTransactionLine[]
  receivingItems   ReceivingItem[]
  truckLoadItems   TruckLoadItem[]
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  creditItems      CreditMemoItem[]
  closeoutItems    RouteCloseoutItem[]
  priceGroupPrices PriceGroupPrice[]
  customerPrices   CustomerPrice[]

  @@unique([organizationId, sku])
  @@unique([organizationId, upc])
  @@index([organizationId, active])
  @@index([organizationId, name])
  @@index([organizationId, categoryId])
  @@map("product")
}

enum UomCode {
  EACH
  CASE
  BOX
  PACK
  TRAY
  CUSTOM
}

/// The only source of packaging truth. Every product has exactly one row with
/// isBase = true and baseUnitsPerUom = 1; cases/boxes/packs are additional rows.
/// Case price is NOT required to equal unit price × factor (docs/02 §Q4).
model ProductUom {
  id               String  @id @default(cuid())
  organizationId   String  @map("organization_id")
  productId        String  @map("product_id")
  code             UomCode
  label            String
  /// How many base units one of these contains. Must be > 0.
  baseUnitsPerUom  Int     @map("base_units_per_uom")
  price            Decimal @default(0) @db.Decimal(12, 4)
  barcode          String?
  isBase           Boolean @default(false) @map("is_base")
  isDefaultSaleUom Boolean @default(false) @map("is_default_sale_uom")
  sortOrder        Int     @default(0) @map("sort_order")
  active           Boolean @default(true)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  creditItems      CreditMemoItem[]
  receivingItems   ReceivingItem[]
  truckLoadItems   TruckLoadItem[]
  priceGroupPrices PriceGroupPrice[]
  customerPrices   CustomerPrice[]

  @@unique([productId, code])
  @@index([organizationId, barcode])
  @@map("product_uom")
}

model TaxRate {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  /// e.g. 0.072500 for 7.25%
  rate           Decimal @db.Decimal(9, 6)
  isDefault      Boolean @default(false) @map("is_default")
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]

  @@unique([organizationId, name])
  @@map("tax_rate")
}

model PriceGroup {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prices       PriceGroupPrice[]
  customers    Customer[]

  @@unique([organizationId, name])
  @@map("price_group")
}

model PriceGroupPrice {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  priceGroupId   String    @map("price_group_id")
  productId      String    @map("product_id")
  productUomId   String?   @map("product_uom_id")
  price          Decimal   @db.Decimal(12, 4)
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceGroup   PriceGroup   @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUom   ProductUom?  @relation(fields: [productUomId], references: [id])

  @@index([organizationId, priceGroupId, productId])
  @@map("price_group_price")
}

model CustomerPrice {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  customerId     String    @map("customer_id")
  productId      String    @map("product_id")
  productUomId   String?   @map("product_uom_id")
  price          Decimal   @db.Decimal(12, 4)
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUom   ProductUom?  @relation(fields: [productUomId], references: [id])

  @@index([organizationId, customerId, productId])
  @@map("customer_price")
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentTerms {
  COD
  NET7
  NET15
  NET30
  NET60
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  accountNumber  String   @map("account_number")
  name           String
  parentCompany  String?  @map("parent_company")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  phone          String?
  email          String?

  priceGroupId     String?      @map("price_group_id")
  paymentTermsCode PaymentTerms @default(COD) @map("payment_terms_code")
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(14, 4)
  taxExempt        Boolean      @default(false) @map("tax_exempt")
  taxExemptId      String?      @map("tax_exempt_id")
  taxRateId        String?      @map("tax_rate_id")

  /// Cache of open AR. Source of truth is the sum of open sale balances less
  /// unapplied payments and open credits; recomputable (docs/02 §A2).
  balance Decimal @default(0) @db.Decimal(14, 4)

  deliveryInstructions String?   @map("delivery_instructions")
  notes                String?
  active               Boolean   @default(true)
  lastVisitAt          DateTime? @map("last_visit_at")
  nextDueOn            DateTime? @map("next_due_on") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceGroup   PriceGroup?        @relation(fields: [priceGroupId], references: [id])
  taxRate      TaxRate?           @relation(fields: [taxRateId], references: [id])
  contacts     CustomerContact[]
  prices       CustomerPrice[]
  schedules    CustomerSchedule[]
  routeStops   RouteStop[]
  sales        Sale[]
  payments     Payment[]
  returns      Return[]
  creditMemos  CreditMemo[]
  refunds      Refund[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, active, name])
  @@index([organizationId, nextDueOn])
  @@map("customer")
}

model CustomerContact {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  customerId     String  @map("customer_id")
  name           String
  title          String?
  phone          String?
  email          String?
  isPrimary      Boolean @default(false) @map("is_primary")
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("customer_contact")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory
//
// A warehouse and a truck differ in what they are, not in how stock moves — so
// both are InventoryLocations and there is exactly one ledger (docs/01 §D1).
// ─────────────────────────────────────────────────────────────────────────────

enum InventoryLocationKind {
  WAREHOUSE
  VEHICLE
  /// Goods taken back from a store that must not be sold again. Held rather
  /// than destroyed on the spot, because "we took it back" and "we wrote it
  /// off" are two events and an auditor is entitled to see both (docs/02 §R3).
  DAMAGED_HOLD
  EXPIRED_HOLD
  /// Staged for return to the supplier who sold it to us.
  SUPPLIER_RETURN_HOLD
}

model InventoryLocation {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  kind           InventoryLocationKind
  name           String
  code           String?
  /// Whether stock here can be sold. False for the three hold locations, which
  /// is what keeps a damaged return out of the truck's sellable on-hand while
  /// still recording that the goods physically came back.
  sellable       Boolean               @default(true)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?
  vehicle      Vehicle?
  balances     InventoryBalance[]
  ledgerLines  InventoryTransactionLine[]
  receivings   Receiving[]
  returnItems  ReturnItem[]

  @@index([organizationId, kind, active])
  @@map("inventory_location")
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  locationId     String   @unique @map("location_id")
  addressLine1   String?  @map("address_line1")
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  /// A route starts where the truck is loaded. Optimising stop order without
  /// this produces an order that looks tidy on a map and wastes the first
  /// twenty minutes of the morning.
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  isPrimary      Boolean  @default(false) @map("is_primary")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("warehouse")
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  locationId     String   @unique @map("location_id")
  name           String
  truckNumber    String   @map("truck_number")
  licensePlate   String?  @map("license_plate")
  assignedUserId String?  @map("assigned_user_id")
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedUser   User?             @relation("VehicleAssignee", fields: [assignedUserId], references: [id])
  routes         Route[]
  truckLoads     TruckLoad[]
  routeTemplates RouteTemplate[]   @relation("RouteTemplateDefaultVehicle")
  memberships    Membership[]

  @@unique([organizationId, truckNumber])
  @@index([organizationId, active])
  @@map("vehicle")
}

/// Derived cache of the ledger, maintained in the same transaction under a row
/// lock. SUM(ledger) must equal this for every pair (docs/02 §L6).
model InventoryBalance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  locationId     String   @map("location_id")
  productId      String   @map("product_id")
  /// Signed integer count of base units.
  quantity       Int      @default(0)
  /// Moving-average cost of one base unit at this location.
  avgUnitCost    Decimal  @default(0) @map("avg_unit_cost") @db.Decimal(16, 6)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([organizationId, productId])
  @@map("inventory_balance")
}

enum InventoryTransactionType {
  SUPPLIER_RECEIPT
  TRUCK_LOAD
  TRUCK_UNLOAD
  TRANSFER
  SALE
  /// Deprecated: superseded by the four CUSTOMER_RETURN_* types below, which
  /// say what happened to the goods instead of leaving it to be inferred.
  CUSTOMER_RETURN
  CUSTOMER_RETURN_SELLABLE
  CUSTOMER_RETURN_DAMAGED
  CUSTOMER_RETURN_EXPIRED
  CUSTOMER_RETURN_SUPPLIER
  DAMAGE
  EXPIRED
  MISSING
  SAMPLE
  CORRECTION
  COUNT_ADJUSTMENT
  REVERSAL
}

/// Append-only. Never updated, never deleted. Mistakes are corrected by posting
/// a CORRECTION or a REVERSAL that points back via reversalOfId (docs/02 §L1).
model InventoryTransaction {
  id              String                   @id @default(cuid())
  organizationId  String                   @map("organization_id")
  type            InventoryTransactionType
  occurredAt      DateTime                 @default(now()) @map("occurred_at")
  createdByUserId String?                  @map("created_by_user_id")
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id")
  reasonCode      String?                  @map("reason_code")
  notes           String?
  idempotencyKey  String?                  @map("idempotency_key")
  reversalOfId    String?                  @map("reversal_of_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                      @relation("InventoryTransactionActor", fields: [createdByUserId], references: [id])
  reversalOf   InventoryTransaction?      @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversals    InventoryTransaction[]     @relation("TransactionReversal")
  lines        InventoryTransactionLine[]
  receiving    Receiving?
  truckLoad    TruckLoad?
  sale         Sale?
  /// A return posts one transaction per disposition, so the link lives on the
  /// items rather than on the return document.
  returnItems  ReturnItem[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, type, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_transaction")
}

model InventoryTransactionLine {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  transactionId  String  @map("transaction_id")
  productId      String  @map("product_id")
  locationId     String  @map("location_id")
  /// Signed base units. For TRANSFER/TRUCK_LOAD/TRUCK_UNLOAD these must sum to
  /// zero per product across the transaction (docs/02 §L2).
  quantityDelta  Int     @map("quantity_delta")
  unitCost       Decimal @map("unit_cost") @db.Decimal(16, 6)
  balanceAfter   Int     @map("balance_after")
  notes          String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id])
  location     InventoryLocation    @relation(fields: [locationId], references: [id])

  @@index([transactionId])
  @@index([organizationId, productId, locationId])
  @@map("inventory_transaction_line")
}

model Receiving {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  supplierId             String?  @map("supplier_id")
  warehouseLocationId    String   @map("warehouse_location_id")
  referenceNumber        String?  @map("reference_number")
  receivedAt             DateTime @default(now()) @map("received_at")
  receivedByUserId       String?  @map("received_by_user_id")
  notes                  String?
  inventoryTransactionId String?  @unique @map("inventory_transaction_id")
  idempotencyKey         String?  @map("idempotency_key")
  createdAt              DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?             @relation(fields: [supplierId], references: [id])
  location     InventoryLocation     @relation(fields: [warehouseLocationId], references: [id])
  receivedBy   User?                 @relation("ReceivingActor", fields: [receivedByUserId], references: [id])
  transaction  InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id])
  items        ReceivingItem[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedAt])
  @@map("receiving")
}

model ReceivingItem {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  receivingId    String  @map("receiving_id")
  productId      String  @map("product_id")
  productUomId   String  @map("product_uom_id")
  quantity       Int
  baseQuantity   Int     @map("base_quantity")
  unitCost       Decimal @map("unit_cost") @db.Decimal(16, 6)
  lineCost       Decimal @map("line_cost") @db.Decimal(14, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiving    Receiving    @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  productUom   ProductUom   @relation(fields: [productUomId], references: [id])

  @@index([receivingId])
  @@map("receiving_item")
}

enum TruckLoadDirection {
  LOAD
  UNLOAD
}

enum TruckLoadStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// A draft load holds no stock; confirming it posts the transfer transaction.
model TruckLoad {
  id                     String             @id @default(cuid())
  organizationId         String             @map("organization_id")
  vehicleId              String             @map("vehicle_id")
  routeId                String?            @map("route_id")
  runnerUserId           String?            @map("runner_user_id")
  direction              TruckLoadDirection @default(LOAD)
  status                 TruckLoadStatus    @default(DRAFT)
  warehouseLocationId    String             @map("warehouse_location_id")
  loadedAt               DateTime?          @map("loaded_at")
  createdByUserId        String?            @map("created_by_user_id")
  notes                  String?
  inventoryTransactionId String?            @unique @map("inventory_transaction_id")
  idempotencyKey         String?            @map("idempotency_key")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle               @relation(fields: [vehicleId], references: [id])
  route        Route?                @relation(fields: [routeId], references: [id])
  runner       User?                 @relation("TruckLoadRunner", fields: [runnerUserId], references: [id])
  createdBy    User?                 @relation("TruckLoadCreator", fields: [createdByUserId], references: [id])
  transaction  InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id])
  items        TruckLoadItem[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, vehicleId, status])
  @@map("truck_load")
}

model TruckLoadItem {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  truckLoadId    String @map("truck_load_id")
  productId      String @map("product_id")
  productUomId   String @map("product_uom_id")
  quantity       Int
  baseQuantity   Int    @map("base_quantity")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  truckLoad    TruckLoad    @relation(fields: [truckLoadId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  productUom   ProductUom   @relation(fields: [productUomId], references: [id])

  @@index([truckLoadId])
  @@map("truck_load_item")
}

// ─────────────────────────────────────────────────────────────────────────────
// Routes
// ─────────────────────────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleFrequency {
  WEEKLY
  BIWEEKLY
  TRIWEEKLY
  MONTHLY
  CUSTOM
}

model RouteTemplate {
  id                  String     @id @default(cuid())
  organizationId      String     @map("organization_id")
  name                String
  code                String?
  color               String?
  dayOfWeek           DayOfWeek? @map("day_of_week")
  defaultRunnerUserId String?    @map("default_runner_user_id")
  defaultVehicleId    String?    @map("default_vehicle_id")
  active              Boolean    @default(true)
  notes               String?
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultRunner  User?              @relation("RouteTemplateDefaultRunner", fields: [defaultRunnerUserId], references: [id])
  defaultVehicle Vehicle?           @relation("RouteTemplateDefaultVehicle", fields: [defaultVehicleId], references: [id])
  schedules      CustomerSchedule[]
  routes         Route[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("route_template")
}

/// The recurring service commitment for one account. "14 accounts due Tuesday"
/// is a query over this table.
model CustomerSchedule {
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  customerId      String            @map("customer_id")
  routeTemplateId String            @map("route_template_id")
  frequency       ScheduleFrequency @default(WEEKLY)
  /// Only for frequency = CUSTOM.
  intervalDays    Int?              @map("interval_days")
  dayOfWeek       DayOfWeek         @map("day_of_week")
  /// For BIWEEKLY/TRIWEEKLY: which week of the cycle this account falls in.
  weekOfCycle     Int?              @map("week_of_cycle")
  sequence        Int               @default(0)
  windowStart     String?           @map("window_start")
  windowEnd       String?           @map("window_end")
  active          Boolean           @default(true)
  lastServicedOn  DateTime?         @map("last_serviced_on") @db.Date
  nextDueOn       DateTime?         @map("next_due_on") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  routeTemplate RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  @@unique([customerId, routeTemplateId])
  @@index([organizationId, dayOfWeek, active])
  @@index([organizationId, nextDueOn])
  @@map("customer_schedule")
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Route {
  id              String      @id @default(cuid())
  organizationId  String      @map("organization_id")
  routeTemplateId String?     @map("route_template_id")
  serviceDate     DateTime    @map("service_date") @db.Date
  name            String
  runnerUserId    String      @map("runner_user_id")
  vehicleId       String?     @map("vehicle_id")
  status          RouteStatus @default(PLANNED)
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  plannedStops    Int         @default(0) @map("planned_stops")
  plannedMiles    Decimal?    @map("planned_miles") @db.Decimal(9, 2)
  plannedMinutes  Int?        @map("planned_minutes")
  actualMiles     Decimal?    @map("actual_miles") @db.Decimal(9, 2)
  startOdometer   Int?        @map("start_odometer")
  endOdometer     Int?        @map("end_odometer")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeTemplate     RouteTemplate?           @relation(fields: [routeTemplateId], references: [id])
  runner            User                     @relation("RouteRunner", fields: [runnerUserId], references: [id])
  vehicle           Vehicle?                 @relation(fields: [vehicleId], references: [id])
  stops             RouteStop[]
  sales             Sale[]
  truckLoads        TruckLoad[]
  closeout          RouteCloseout?
  assignmentHistory RouteAssignmentHistory[]

  @@unique([organizationId, routeTemplateId, serviceDate])
  @@index([organizationId, runnerUserId, serviceDate])
  @@index([organizationId, serviceDate, status])
  @@map("route")
}

enum RouteStopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  COMPLETED
  SKIPPED
  NO_SALE
  STORE_CLOSED
  RESCHEDULED
}

model RouteStop {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  routeId           String          @map("route_id")
  customerId        String          @map("customer_id")
  sequence          Int
  status            RouteStopStatus @default(PENDING)
  plannedArrivalAt  DateTime?       @map("planned_arrival_at")
  arrivedAt         DateTime?       @map("arrived_at")
  completedAt       DateTime?       @map("completed_at")
  distanceMiles     Decimal?        @map("distance_miles") @db.Decimal(9, 2)
  durationMinutes   Int?            @map("duration_minutes")
  outcomeReason     String?         @map("outcome_reason")
  rescheduledToDate DateTime?       @map("rescheduled_to_date") @db.Date
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route             Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customer          Customer                 @relation(fields: [customerId], references: [id])
  sales             Sale[]
  payments          Payment[]
  returns           Return[]
  assignmentHistory RouteAssignmentHistory[]

  @@unique([routeId, customerId])
  @@index([routeId, sequence])
  @@index([organizationId, status])
  @@map("route_stop")
}

/// Appended when work moves between runners. The original route is never
/// rewritten, so "who was supposed to run this" stays answerable.
model RouteAssignmentHistory {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  routeId         String   @map("route_id")
  routeStopId     String?  @map("route_stop_id")
  fromUserId      String?  @map("from_user_id")
  toUserId        String   @map("to_user_id")
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route        Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeStop    RouteStop?   @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  fromUser     User?        @relation("ReassignFrom", fields: [fromUserId], references: [id])
  toUser       User         @relation("ReassignTo", fields: [toUserId], references: [id])
  createdBy    User?        @relation("ReassignActor", fields: [createdByUserId], references: [id])

  @@index([organizationId, routeId])
  @@map("route_assignment_history")
}

enum CloseoutStatus {
  OPEN
  SUBMITTED
  APPROVED
  DISPUTED
}

model RouteCloseout {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  routeId           String         @unique @map("route_id")
  status            CloseoutStatus @default(OPEN)
  submittedAt       DateTime?      @map("submitted_at")
  submittedByUserId String?        @map("submitted_by_user_id")
  reviewedAt        DateTime?      @map("reviewed_at")
  reviewedByUserId  String?        @map("reviewed_by_user_id")

  salesTotal     Decimal @default(0) @map("sales_total") @db.Decimal(14, 4)
  returnsTotal   Decimal @default(0) @map("returns_total") @db.Decimal(14, 4)
  expectedCash   Decimal @default(0) @map("expected_cash") @db.Decimal(14, 4)
  actualCash     Decimal @default(0) @map("actual_cash") @db.Decimal(14, 4)
  checkTotal     Decimal @default(0) @map("check_total") @db.Decimal(14, 4)
  cardTotal      Decimal @default(0) @map("card_total") @db.Decimal(14, 4)
  achTotal       Decimal @default(0) @map("ach_total") @db.Decimal(14, 4)
  onAccountTotal Decimal @default(0) @map("on_account_total") @db.Decimal(14, 4)
  cashVariance   Decimal @default(0) @map("cash_variance") @db.Decimal(14, 4)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route        Route               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  submittedBy  User?               @relation("CloseoutSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy   User?               @relation("CloseoutReviewer", fields: [reviewedByUserId], references: [id])
  items        RouteCloseoutItem[]

  @@index([organizationId, status])
  @@map("route_closeout")
}

model RouteCloseoutItem {
  id               String  @id @default(cuid())
  organizationId   String  @map("organization_id")
  closeoutId       String  @map("closeout_id")
  productId        String  @map("product_id")
  expectedQuantity Int     @map("expected_quantity")
  countedQuantity  Int?    @map("counted_quantity")
  varianceQuantity Int     @default(0) @map("variance_quantity")
  varianceValue    Decimal @default(0) @map("variance_value") @db.Decimal(14, 4)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closeout     RouteCloseout @relation(fields: [closeoutId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])

  @@unique([closeoutId, productId])
  @@map("route_closeout_item")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales, receipts, payments, returns
//
// A completed Sale with balanceDue > 0 IS the open invoice; Receipt is its
// printable rendering. One document, so the two can never disagree (docs/02 §A1).
// ─────────────────────────────────────────────────────────────────────────────

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum PriceSource {
  STANDARD
  GROUP
  CUSTOMER
  PROMO
  MANUAL
}

model Sale {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  saleNumber     String     @map("sale_number")
  customerId     String     @map("customer_id")
  routeId        String?    @map("route_id")
  routeStopId    String?    @map("route_stop_id")
  soldByUserId   String     @map("sold_by_user_id")
  status         SaleStatus @default(DRAFT)
  occurredAt     DateTime   @default(now()) @map("occurred_at")

  subtotal       Decimal @default(0) @db.Decimal(14, 4)
  discountTotal  Decimal @default(0) @map("discount_total") @db.Decimal(14, 4)
  taxTotal       Decimal @default(0) @map("tax_total") @db.Decimal(14, 4)
  total          Decimal @default(0) @db.Decimal(14, 4)
  amountPaid     Decimal @default(0) @map("amount_paid") @db.Decimal(14, 4)
  creditsApplied Decimal @default(0) @map("credits_applied") @db.Decimal(14, 4)
  balanceDue     Decimal @default(0) @map("balance_due") @db.Decimal(14, 4)

  dueDate          DateTime?    @map("due_date") @db.Date
  paymentTermsCode PaymentTerms @default(COD) @map("payment_terms_code")
  taxExempt        Boolean      @default(false) @map("tax_exempt")
  notes            String?

  /// Minted client-side when the cart is created, so a retry after a timeout in
  /// a dead-zone store cannot bill the store twice (docs/02 §I1).
  idempotencyKey String @map("idempotency_key")

  /// The store and the company AS THEY WERE when this sale posted.
  ///
  /// Line items already snapshot their product name, unit and price; these two
  /// finish the job for the header. A receipt reprinted next year has to show
  /// the address the goods went to and the company name that billed for them,
  /// not whatever those records say today (docs/02 §L5). Null on sales written
  /// before this column existed — readers fall back to the live rows.
  billToJson Json? @map("bill_to_json")
  issuerJson Json? @map("issuer_json")

  inventoryTransactionId String?   @unique @map("inventory_transaction_id")
  voidedAt               DateTime? @map("voided_at")
  voidedByUserId         String?   @map("voided_by_user_id")
  voidReason             String?   @map("void_reason")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer                @relation(fields: [customerId], references: [id])
  route              Route?                  @relation(fields: [routeId], references: [id])
  routeStop          RouteStop?              @relation(fields: [routeStopId], references: [id])
  soldBy             User                    @relation("SaleSeller", fields: [soldByUserId], references: [id])
  voidedBy           User?                   @relation("SaleVoider", fields: [voidedByUserId], references: [id])
  transaction        InventoryTransaction?   @relation(fields: [inventoryTransactionId], references: [id])
  items              SaleItem[]
  receipt            Receipt?
  deliveries         ReceiptDelivery[]
  shareLinks         ReceiptShareLink[]
  signature          Signature?
  paymentAllocations PaymentAllocation[]
  creditApplications CreditMemoApplication[]
  creditMemos        CreditMemo[]
  returns            Return[]

  @@unique([organizationId, saleNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, routeId])
  @@index([organizationId, soldByUserId, occurredAt])
  @@map("sale")
}

model SaleItem {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  saleId         String @map("sale_id")
  productId      String @map("product_id")
  productUomId   String @map("product_uom_id")

  /// Snapshots: renaming a product must not rewrite last year's receipts.
  productNameSnapshot String @map("product_name_snapshot")
  skuSnapshot         String @map("sku_snapshot")
  uomLabelSnapshot    String @map("uom_label_snapshot")

  quantity     Int
  baseQuantity Int @map("base_quantity")

  unitPrice      Decimal     @map("unit_price") @db.Decimal(12, 4)
  lineSubtotal   Decimal     @map("line_subtotal") @db.Decimal(14, 4)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(14, 4)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(14, 4)
  lineTotal      Decimal     @map("line_total") @db.Decimal(14, 4)
  /// COGS is fixed at the moment of sale; later cost changes never restate a
  /// closed month (docs/02 §L5).
  unitCostAtSale Decimal     @default(0) @map("unit_cost_at_sale") @db.Decimal(16, 6)
  priceSource    PriceSource @default(STANDARD) @map("price_source")
  sortOrder      Int         @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  productUom   ProductUom   @relation(fields: [productUomId], references: [id])
  returnItems  ReturnItem[]
  creditItems  CreditMemoItem[]

  @@index([saleId])
  @@index([organizationId, productId])
  @@map("sale_item")
}

model Receipt {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  saleId         String    @unique @map("sale_id")
  receiptNumber  String    @map("receipt_number")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  signatureId    String?   @unique @map("signature_id")
  pdfPath        String?   @map("pdf_path")
  emailedAt      DateTime? @map("emailed_at")
  textedAt       DateTime? @map("texted_at")
  printedAt      DateTime? @map("printed_at")
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  signature    Signature?   @relation(fields: [signatureId], references: [id])

  @@unique([organizationId, receiptNumber])
  @@map("receipt")
}

enum DeliveryChannel {
  EMAIL
  SMS
  LINK
  PRINT
  DOWNLOAD
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

/// Every attempt to put a receipt in front of a customer (spec §25).
///
/// Append-only. A failed send writes a FAILED row and nothing else — it must
/// never touch the sale, because the money moved whether or not the email
/// landed (docs/02 §A5). PRINT and DOWNLOAD rows carry no destination; they
/// record that a document left the building, which is what an audit asks.
model ReceiptDelivery {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  /// Exactly one of these is set. A delivery is always of one document, and
  /// which kind it is decides how it renders (spec §10).
  saleId         String?        @map("sale_id")
  creditMemoId   String?        @map("credit_memo_id")
  channel        DeliveryChannel
  /// Email address or phone number. Null for PRINT and DOWNLOAD.
  destination    String?
  status         DeliveryStatus @default(QUEUED)
  /// Which provider handled it, so a vendor switch stays legible in history.
  provider       String?
  providerMessageId String?     @map("provider_message_id")
  failureReason  String?        @map("failure_reason")
  sentByUserId   String?        @map("sent_by_user_id")
  shareLinkId    String?        @map("share_link_id")
  attemptedAt    DateTime       @default(now()) @map("attempted_at")
  completedAt    DateTime?      @map("completed_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  creditMemo   CreditMemo?       @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  sentBy       User?             @relation("DeliverySender", fields: [sentByUserId], references: [id])
  shareLink    ReceiptShareLink? @relation(fields: [shareLinkId], references: [id])

  @@index([organizationId, saleId, attemptedAt])
  @@index([organizationId, creditMemoId, attemptedAt])
  @@index([organizationId, status, attemptedAt])
  @@map("receipt_delivery")
}

/// A capability URL for one receipt (spec §25).
///
/// The token is 32 random bytes and is stored only as a sha256 digest, so a
/// database leak does not hand out working links. The row grants exactly one
/// sale — a viewer cannot walk to another receipt, another store, or another
/// organization, because nothing here is enumerable and the lookup is by hash.
model ReceiptShareLink {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// Exactly one of these is set; the token grants that one document.
  saleId         String?   @map("sale_id")
  creditMemoId   String?   @map("credit_memo_id")
  tokenHash      String    @unique @map("token_hash")
  createdByUserId String?  @map("created_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// Null means it does not expire. A store asking for last March's invoice in
  /// December is ordinary, so links are long-lived by default (docs/03 §7).
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastViewedAt   DateTime? @map("last_viewed_at")
  viewCount      Int       @default(0) @map("view_count")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  creditMemo   CreditMemo?       @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ShareLinkCreator", fields: [createdByUserId], references: [id])
  deliveries   ReceiptDelivery[]

  @@index([organizationId, saleId])
  @@index([organizationId, creditMemoId])
  @@map("receipt_share_link")
}

model Signature {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  saleId         String?  @unique @map("sale_id")
  returnId       String?  @unique @map("return_id")
  signerName     String?  @map("signer_name")
  imagePng       Bytes    @map("image_png")
  capturedAt     DateTime @default(now()) @map("captured_at")
  deviceInfo     String?  @map("device_info")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  return       Return?      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  receipt      Receipt?

  @@index([organizationId])
  @@map("signature")
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OTHER
}

enum PaymentStatus {
  POSTED
  REVERSED
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  customerId       String        @map("customer_id")
  method           PaymentMethod
  amount           Decimal       @db.Decimal(14, 4)
  /// Over-payment is legal and lands here as credit on account (docs/02 §A3).
  unappliedAmount  Decimal       @default(0) @map("unapplied_amount") @db.Decimal(14, 4)
  receivedAt       DateTime      @default(now()) @map("received_at")
  receivedByUserId String?       @map("received_by_user_id")
  routeStopId      String?       @map("route_stop_id")
  checkNumber      String?       @map("check_number")
  referenceNumber  String?       @map("reference_number")
  /// Reserved for Stripe/ACH processors; V1 records the tender only.
  processorRef     String?       @map("processor_ref")
  notes            String?
  status           PaymentStatus @default(POSTED)
  reversedAt       DateTime?     @map("reversed_at")
  reversedByUserId String?       @map("reversed_by_user_id")
  reversalOfId     String?       @unique @map("reversal_of_id")
  idempotencyKey   String        @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  receivedBy   User?               @relation("PaymentReceiver", fields: [receivedByUserId], references: [id])
  reversedBy   User?               @relation("PaymentReverser", fields: [reversedByUserId], references: [id])
  routeStop    RouteStop?          @relation(fields: [routeStopId], references: [id])
  reversalOf   Payment?            @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversal     Payment?            @relation("PaymentReversal")
  allocations  PaymentAllocation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, customerId, receivedAt])
  @@index([organizationId, receivedAt])
  @@map("payment")
}

model PaymentAllocation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  paymentId      String   @map("payment_id")
  saleId         String   @map("sale_id")
  amount         Decimal  @db.Decimal(14, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@index([paymentId])
  @@index([organizationId, saleId])
  @@map("payment_allocation")
}

/// Structured, not free text: "why are we taking product back" is a question
/// somebody will want to group by (spec §2).
enum ReturnReason {
  DAMAGED
  EXPIRED
  WRONG_ITEM
  UNSOLD
  SWAP
  PRICING_ERROR
  DELIVERY_ERROR
  OTHER
}

/// What happens to the goods, per line. A return of three cases can put two
/// back on the truck and write one off, and one disposition per document
/// cannot express that (spec §3).
enum ReturnDisposition {
  RESTOCK_TRUCK
  RESTOCK_WAREHOUSE
  DAMAGED
  EXPIRED
  SUPPLIER_RETURN
  /// A credit with nothing coming back — a pricing mistake, a goodwill credit.
  /// No ledger line is posted at all.
  NONE
}

/// What the money does. Deliberately separate from the disposition: goods and
/// money are independent consequences of the same event (spec §3).
enum ReturnFinancialAction {
  /// Credit issued and applied to the customer's open invoices, oldest first.
  APPLY_TO_BALANCE
  /// Credit issued and left on the account for later.
  ACCOUNT_CREDIT
  /// Credit issued and immediately refunded.
  REFUND
  /// Goods back, no credit. Rare, and it is a choice somebody has to make.
  NONE
}

enum ReturnStatus {
  COMPLETED
  VOIDED
}

/// A physical return (spec §1).
///
/// The originating sale is never edited. A return is a new document that
/// references it, carries its own number, and posts its own ledger lines. What
/// was sold, what came back, why, where it went, what credit was issued and
/// whether cash left the drawer are all separately answerable afterwards.
model Return {
  id              String                @id @default(cuid())
  organizationId  String                @map("organization_id")
  returnNumber    String                @map("return_number")
  customerId      String                @map("customer_id")
  /// Null for a return with no identifiable original sale. Where it is set,
  /// the returnable-quantity guard runs against that sale's lines.
  saleId          String?               @map("sale_id")
  routeStopId     String?               @map("route_stop_id")
  createdByUserId String?               @map("created_by_user_id")
  occurredAt      DateTime              @default(now()) @map("occurred_at")
  /// Document-level reason. Each line may carry its own.
  reason          ReturnReason
  financialAction ReturnFinancialAction @map("financial_action")

  subtotal Decimal      @default(0) @db.Decimal(14, 4)
  taxTotal Decimal      @default(0) @map("tax_total") @db.Decimal(14, 4)
  total    Decimal      @default(0) @db.Decimal(14, 4)
  status   ReturnStatus @default(COMPLETED)

  creditMemoId   String?  @unique @map("credit_memo_id")
  idempotencyKey String   @map("idempotency_key")
  notes          String?
  voidedAt       DateTime? @map("voided_at")
  voidedByUserId String?   @map("voided_by_user_id")
  voidReason     String?   @map("void_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])
  routeStop    RouteStop?   @relation(fields: [routeStopId], references: [id])
  createdBy    User?        @relation("ReturnCreator", fields: [createdByUserId], references: [id])
  voidedBy     User?        @relation("ReturnVoider", fields: [voidedByUserId], references: [id])
  creditMemo   CreditMemo?  @relation(fields: [creditMemoId], references: [id])
  items        ReturnItem[]
  signature    Signature?

  @@unique([organizationId, returnNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, saleId])
  @@map("sales_return")
}

model ReturnItem {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  returnId       String @map("return_id")
  /// The exact line being returned against, which is what makes the
  /// returnable-quantity guard precise rather than per-product (spec §1).
  saleItemId     String? @map("sale_item_id")
  productId      String @map("product_id")
  productUomId   String @map("product_uom_id")

  productNameSnapshot String @map("product_name_snapshot")
  skuSnapshot         String @map("sku_snapshot")
  uomLabelSnapshot    String @map("uom_label_snapshot")

  quantity     Int
  baseQuantity Int @map("base_quantity")

  /// The cost frozen on the original sale line. The COGS reversal uses this and
  /// never today's cost (spec §21, docs/02 §L5).
  unitCostAtSale Decimal @default(0) @map("unit_cost_at_sale") @db.Decimal(16, 6)

  disposition  ReturnDisposition
  reason       ReturnReason
  /// Where the goods landed. Null when the disposition is NONE.
  locationId   String? @map("location_id")
  /// The ledger transaction that moved them. Shared by every line in this
  /// return with the same disposition; null when nothing moved.
  inventoryTransactionId String? @map("inventory_transaction_id")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  return       Return                @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem?             @relation(fields: [saleItemId], references: [id])
  product      Product               @relation(fields: [productId], references: [id])
  productUom   ProductUom            @relation(fields: [productUomId], references: [id])
  location     InventoryLocation?    @relation(fields: [locationId], references: [id])
  transaction  InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id])

  @@index([returnId])
  @@index([organizationId, saleItemId])
  @@map("sales_return_item")
}

enum CreditMemoStatus {
  OPEN
  APPLIED
  VOIDED
}

/// The financial document (spec §4).
///
/// Its own immutable number, its own line snapshots, and a remaining balance
/// that is drawn down by allocations to invoices and by refunds. A credit memo
/// can exist without a return — a pricing correction credits money with nothing
/// coming back.
model CreditMemo {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  customerId     String           @map("customer_id")
  number         String
  /// The sale this credit relates to, where there is one.
  saleId         String?          @map("sale_id")
  issuedByUserId String?          @map("issued_by_user_id")
  reason         ReturnReason     @default(OTHER)

  subtotal       Decimal @default(0) @db.Decimal(14, 4)
  discountTotal  Decimal @default(0) @map("discount_total") @db.Decimal(14, 4)
  taxTotal       Decimal @default(0) @map("tax_total") @db.Decimal(14, 4)
  /// Total credit. `amount` is the document total; `remainingAmount` is what is
  /// still unspent after allocations and refunds.
  amount          Decimal          @db.Decimal(14, 4)
  remainingAmount Decimal          @map("remaining_amount") @db.Decimal(14, 4)
  refundedAmount  Decimal          @default(0) @map("refunded_amount") @db.Decimal(14, 4)
  status          CreditMemoStatus @default(OPEN)
  issuedAt        DateTime         @default(now()) @map("issued_at")
  notes           String?

  /// The store and the company as they were when this credit was issued, the
  /// same snapshot a receipt carries (docs/02 §L5).
  billToJson Json? @map("bill_to_json")
  issuerJson Json? @map("issuer_json")

  voidedAt       DateTime? @map("voided_at")
  voidedByUserId String?   @map("voided_by_user_id")
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer                @relation(fields: [customerId], references: [id])
  sale         Sale?                   @relation(fields: [saleId], references: [id])
  issuedBy     User?                   @relation("CreditIssuer", fields: [issuedByUserId], references: [id])
  voidedBy     User?                   @relation("CreditVoider", fields: [voidedByUserId], references: [id])
  return       Return?
  items        CreditMemoItem[]
  applications CreditMemoApplication[]
  refunds      Refund[]
  deliveries   ReceiptDelivery[]
  shareLinks   ReceiptShareLink[]

  @@unique([organizationId, number])
  @@index([organizationId, customerId, status])
  @@index([organizationId, issuedAt])
  @@map("credit_memo")
}

/// One credited line, snapshotted. Never reconstructed from today's prices.
model CreditMemoItem {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  creditMemoId   String  @map("credit_memo_id")
  saleItemId     String? @map("sale_item_id")
  productId      String? @map("product_id")
  productUomId   String? @map("product_uom_id")

  descriptionSnapshot String @map("description_snapshot")
  skuSnapshot         String @default("") @map("sku_snapshot")
  uomLabelSnapshot    String @default("") @map("uom_label_snapshot")

  quantity     Int @default(0)
  baseQuantity Int @default(0) @map("base_quantity")

  /// The price actually charged on the original line, not today's price.
  unitPrice      Decimal @default(0) @map("unit_price") @db.Decimal(12, 4)
  lineSubtotal   Decimal @default(0) @map("line_subtotal") @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 4)
  /// Tax reversed on this line, derived from the original sale's tax, not from
  /// recomputing today's rules (spec §5).
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 4)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(14, 4)
  /// True when the original line was taxed. Kept so a reversal can be explained.
  taxable        Boolean @default(false)
  /// Historical COGS to reverse. Zero when nothing physically came back.
  unitCostAtSale Decimal @default(0) @map("unit_cost_at_sale") @db.Decimal(16, 6)

  reason    ReturnReason @default(OTHER)
  sortOrder Int          @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditMemo   CreditMemo   @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  saleItem     SaleItem?    @relation(fields: [saleItemId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  productUom   ProductUom?  @relation(fields: [productUomId], references: [id])

  @@index([creditMemoId])
  @@index([organizationId, saleItemId])
  @@map("credit_memo_item")
}

enum CreditApplicationStatus {
  APPLIED
  REVERSED
}

model CreditMemoApplication {
  id             String                  @id @default(cuid())
  organizationId String                  @map("organization_id")
  creditMemoId   String                  @map("credit_memo_id")
  saleId         String                  @map("sale_id")
  amount         Decimal                 @db.Decimal(14, 4)
  status         CreditApplicationStatus @default(APPLIED)
  appliedAt      DateTime                @default(now()) @map("applied_at")
  appliedByUserId String?                @map("applied_by_user_id")
  reversedAt     DateTime?               @map("reversed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditMemo   CreditMemo   @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id])
  appliedBy    User?        @relation("CreditApplier", fields: [appliedByUserId], references: [id])

  @@index([creditMemoId])
  @@index([organizationId, saleId])
  @@map("credit_memo_application")
}

enum RefundStatus {
  POSTED
  VOIDED
}

/// Money leaving the drawer (spec §8).
///
/// Not a reversed payment: a payment that never happened and a refund of one
/// that did are different events, and collapsing them loses the cash trail. A
/// refund draws down a credit memo's remaining balance.
model Refund {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  refundNumber   String        @map("refund_number")
  customerId     String        @map("customer_id")
  creditMemoId   String        @map("credit_memo_id")
  amount         Decimal       @db.Decimal(14, 4)
  method         PaymentMethod
  issuedAt       DateTime      @default(now()) @map("issued_at")
  issuedByUserId String?       @map("issued_by_user_id")
  /// Cheque number, card authorisation, ACH trace — whatever proves it left.
  referenceNumber String?      @map("reference_number")
  notes          String?
  status         RefundStatus  @default(POSTED)
  voidedAt       DateTime?     @map("voided_at")
  voidedByUserId String?       @map("voided_by_user_id")
  voidReason     String?       @map("void_reason")
  idempotencyKey String        @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  creditMemo   CreditMemo   @relation(fields: [creditMemoId], references: [id])
  issuedBy     User?        @relation("RefundIssuer", fields: [issuedByUserId], references: [id])
  voidedBy     User?        @relation("RefundVoider", fields: [voidedByUserId], references: [id])

  @@unique([organizationId, refundNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, customerId, issuedAt])
  @@index([organizationId, creditMemoId])
  @@map("refund")
}

/// Atomic document numbering. Incremented with SELECT … FOR UPDATE inside the
/// writing transaction, so two runners can never mint the same receipt number.
model DocumentSequence {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  docType        String   @map("doc_type")
  prefix         String   @default("")
  nextNumber     Int      @default(1) @map("next_number")
  padTo          Int      @default(5) @map("pad_to")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, docType])
  @@map("document_sequence")
}

// ─────────────────────────────────────────────────────────────────────────────
// Imports
// ─────────────────────────────────────────────────────────────────────────────

enum ImportType {
  PRODUCTS
  CUSTOMERS
}

enum ImportStatus {
  UPLOADED
  MAPPING
  VALIDATING
  PREVIEW
  IMPORTING
  COMPLETED
  CANCELLED
  FAILED
}

enum ImportMode {
  CREATE_ONLY
  UPDATE_ONLY
  UPSERT
}

enum ImportMatchKey {
  SKU
  UPC
  ACCOUNT_NUMBER
  NAME
}

model ImportJob {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  type           ImportType
  fileName       String         @map("file_name")
  fileSize       Int            @map("file_size")
  storagePath    String?        @map("storage_path")
  status         ImportStatus   @default(UPLOADED)
  mode           ImportMode     @default(UPSERT)
  matchKey       ImportMatchKey @default(SKU) @map("match_key")

  /// { snackloadField: incomingHeader } chosen by the user in the mapping step.
  columnMapJson    Json @default("{}") @map("column_map_json")
  /// Resolutions for ambiguous references (route names, runner names).
  referenceMapJson Json @default("{}") @map("reference_map_json")

  totalRows    Int @default(0) @map("total_rows")
  readyRows    Int @default(0) @map("ready_rows")
  warningRows  Int @default(0) @map("warning_rows")
  errorRows    Int @default(0) @map("error_rows")
  importedRows Int @default(0) @map("imported_rows")
  skippedRows  Int @default(0) @map("skipped_rows")

  createdByUserId String?   @map("created_by_user_id")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  summaryJson     Json      @default("{}") @map("summary_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ImportCreator", fields: [createdByUserId], references: [id])
  rows         ImportRow[]

  @@index([organizationId, type, createdAt])
  @@map("import_job")
}

enum ImportRowStatus {
  PENDING
  READY
  WARNING
  ERROR
  IMPORTED
  SKIPPED
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
}

/// Rows persist after the job completes, so "where did this price come from"
/// stays answerable months later.
model ImportRow {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  importJobId    String          @map("import_job_id")
  rowNumber      Int             @map("row_number")
  rawJson        Json            @map("raw_json")
  normalizedJson Json            @default("{}") @map("normalized_json")
  status         ImportRowStatus @default(PENDING)
  action         ImportRowAction @default(CREATE)
  messagesJson   Json            @default("[]") @map("messages_json")
  targetType     String?         @map("target_type")
  targetId       String?         @map("target_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@map("import_row")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations (QuickBooks Online first; the layer is provider-agnostic)
// ─────────────────────────────────────────────────────────────────────────────

enum IntegrationProvider {
  QUICKBOOKS_ONLINE
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

model IntegrationConnection {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  provider       IntegrationProvider
  status         IntegrationStatus   @default(DISCONNECTED)
  realmId        String?             @map("realm_id")
  companyName    String?             @map("company_name")

  /// AES-256-GCM sealed as v1:iv:tag:ciphertext. Decrypted only inside the
  /// integration service; never logged, never returned by any API (docs/04 §7).
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  refreshExpiresAt      DateTime? @map("refresh_expires_at")

  connectedByUserId String?   @map("connected_by_user_id")
  connectedAt       DateTime? @map("connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  settingsJson      Json      @default("{}") @map("settings_json")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("IntegrationConnector", fields: [connectedByUserId], references: [id])

  @@unique([organizationId, provider])
  @@map("integration_connection")
}

/// Durable identity across systems. This table is why we never re-match on name.
model ExternalMapping {
  id                String              @id @default(cuid())
  organizationId    String              @map("organization_id")
  provider          IntegrationProvider
  entityType        String              @map("entity_type")
  localId           String              @map("local_id")
  externalId        String              @map("external_id")
  externalSyncToken String?             @map("external_sync_token")
  lastSyncedAt      DateTime?           @map("last_synced_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, entityType, localId])
  @@unique([organizationId, provider, entityType, externalId])
  @@map("external_mapping")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
  RETRYING
  NEEDS_ATTENTION
}

model SyncJob {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  provider       IntegrationProvider
  entityType     String              @map("entity_type")
  localId        String              @map("local_id")
  operation      String
  status         SyncStatus          @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at")
  lastError      String?             @map("last_error")
  payloadJson    Json                @default("{}") @map("payload_json")
  createdAt      DateTime            @default(now()) @map("created_at")
  completedAt    DateTime?           @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         SyncLog[]

  @@index([status, nextAttemptAt])
  @@index([organizationId, entityType, localId])
  @@map("sync_job")
}

model SyncLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  syncJobId      String   @map("sync_job_id")
  attempt        Int
  level          String
  message        String
  requestJson    Json?    @map("request_json")
  responseJson   Json?    @map("response_json")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncJob      SyncJob      @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Operations
// ─────────────────────────────────────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// Written in the same transaction as the business change it describes, so an
/// event can never be lost when the write succeeds.
model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  type           String
  payloadJson    Json         @map("payload_json")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  processedAt    DateTime?    @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_event")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  userId         String?              @map("user_id")
  type           String
  severity       NotificationSeverity @default(INFO)
  title          String
  body           String?
  dataJson       Json                 @default("{}") @map("data_json")
  readAt         DateTime?            @map("read_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notification")
}

/// Written inside the same transaction as the change, so an audit entry cannot
/// go missing when a write succeeds.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_log")
}
