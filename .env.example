# Copy to .env and fill in. Generate each secret with: openssl rand -base64 32
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/snackload?schema=public"
SESSION_SECRET="replace-me-32-bytes-base64"
ENCRYPTION_KEY="replace-me-32-bytes-base64"
APP_URL="http://localhost:3000"

# QuickBooks Online (Phase 8). From the Intuit developer dashboard. Leave both
# unset and the integration shows as unavailable rather than offering a button
# that cannot work. Sandbox or production is chosen per connection, in the UI —
# never here (docs/08 §3).
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
#
# The verifier token from the same dashboard. Without it the webhook endpoint
# refuses every delivery rather than trusting an unsigned one.
# QUICKBOOKS_WEBHOOK_VERIFIER=
#
# Development only: drives the QuickBooks screens against an in-memory fake, so
# they can be demonstrated without an Intuit app. The server REFUSES TO START
# with this set in production — a silently faked accounting integration is worse
# than none, because the books look synced and are not.
# QUICKBOOKS_USE_FAKE=true
#
# The bearer token a scheduler presents to POST /api/internal/quickbooks/sync.
# Unset means that route refuses every request, and QuickBooks only syncs when
# somebody presses Sync now. Point a cron at it every few minutes:
#   curl -fsS -X POST -H "Authorization: Bearer $SYNC_WORKER_TOKEN" \
#        https://your-app/api/internal/quickbooks/sync
# SYNC_WORKER_TOKEN=
